{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-gemini-auth"
  ],
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--browser-url",
        "http://127.0.0.1:9222"
      ],
      "enabled": true
    }
  }
}
